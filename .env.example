# Copy to .env and change before going live.

# "production" makes the API refuse a weak SECRET_KEY.
ENVIRONMENT=development

# Generate with: openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef

# The database password is fixed when the database is first created.
# If you already ran StockPilot without a .env file, keep it as "stockpilot";
# changing it here alone makes the API fail with "password authentication failed".
POSTGRES_DB=stockpilot
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=stockpilot

# Only needed if a browser calls the API directly. Comma-separated.
CORS_ORIGINS=http://localhost:3000

# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# Creates the demo company on first start. Set to false in production.
SEED_DEMO_DATA=true

# Public address of the web app (used in links inside emails).
APP_URL=http://localhost:3000

# Email: any SMTP service. Leave SMTP_HOST empty to write emails to the worker log instead
# (see them with: docker compose logs worker).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
EMAIL_FROM=StockPilot <no-reply@example.com>

# SMS and WhatsApp alerts through Twilio (optional).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Subscriptions: only for selling StockPilot to other businesses. Leave false when
# StockPilot runs your own business (everything is then unlimited and free).
BILLING_ENABLED=false
# From the Paystack dashboard → Settings → API Keys & Webhooks (sk_test_… while testing).
PAYSTACK_SECRET_KEY=
BILLING_CURRENCY=NGN
TRIAL_DAYS=14
GRACE_DAYS=7
# Monthly prices; yearly is 10 x monthly. Empty = starter=15000,business=35000,pro=75000
PLAN_PRICES=

WEB_CONCURRENCY=2
WEB_PORT=3000
API_PORT=8000
